# ============================================================
#  AI PROVIDER — switch between openai and gemini here
#  Values: openai | gemini
# ============================================================
AI_PROVIDER=openai

# ────────────────────────────────────────────────────────────
#  OPENAI SETTINGS  (used when AI_PROVIDER=openai)
# ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
API_BASE_URL=https://api.openai.com/v1

# ────────────────────────────────────────────────────────────
#  GEMINI SETTINGS  (used when AI_PROVIDER=gemini)
# ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Available models: gemini-3.6-flash | gemini-1.5-pro | gemini-1.5-flash
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ──────────────────────────────────────────────
#  KEYBOARD CONTROLS
# ──────────────────────────────────────────────

# --- Trigger Sequences (type these anywhere) ---
# Take a screenshot and add to queue (max 7)
KEY_SCREENSHOT=qwe

# Start recording keyboard text input
KEY_START_INPUT=asd

# Submit captured text + screenshots to AI and solve
KEY_SOLVE=jkl

# Submit for a short debug/explain summary (10-20 words)
KEY_DEBUG=debug

# Clear all buffers and queues
KEY_CLEAR=clear

# --- Automation Control Hotkeys ---
# Pause mouse movement or auto-typing
KEY_PAUSE=<alt>+<space>

# Resume after pause
KEY_RESUME=<ctrl>+<space>

# --- Global Kill Hotkey ---
# Instantly terminates the agent process.
# Format: <ctrl>+<alt>+a  |  <ctrl>+<shift>+q  |  etc.
KEY_KILL_HOTKEY=<ctrl>+<alt>+a

# --- Automation Speed ---
# Target typing speed in Words Per Minute (default is 55)
TYPING_WPM=55

# ──────────────────────────────────────────────
#  PROXY SETTINGS
# ──────────────────────────────────────────────

# TCP port that proxy.exe listens on and agent.py connects to.
# Change only if 9920 is already in use on your machine.
PROXY_PORT=9920
